---
export interface Props {
  featuredImage: string;
  featuredTitle: string;
  featuredSlug: string;
  featuredSoftware?: string;
  featuredLayers?: number;
}

const { featuredImage, featuredTitle, featuredSlug, featuredSoftware = 'KiCad', featuredLayers = 2 } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
---

<section class="relative pt-28 sm:pt-32 pb-16 sm:pb-24 overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-b from-brand-50/60 via-white to-white pointer-events-none" />

  <svg
    class="absolute inset-0 w-full h-full opacity-[0.05] pointer-events-none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <defs>
      <pattern id="pcb-trace" x="0" y="0" width="120" height="120" patternUnits="userSpaceOnUse">
        <g fill="none" stroke="#10b981" stroke-width="1.5" stroke-linecap="round">
          <path d="M0 40 H40 V80 H100" />
          <path d="M40 0 V40 H80 V100" />
          <path d="M0 110 H30 V70 H70 V30 H120" />
          <path d="M90 0 V50 H120" />
          <path d="M110 60 H120" />
        </g>
        <g fill="#10b981">
          <circle cx="100" cy="80" r="5" />
          <circle cx="40" cy="80" r="4" />
          <circle cx="80" cy="100" r="4" />
          <circle cx="30" cy="70" r="5" />
          <circle cx="90" cy="50" r="3" />
          <circle cx="110" cy="60" r="3" />
        </g>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#pcb-trace)" />
  </svg>

  <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-gradient-to-bl from-brand-100/40 to-transparent rounded-full blur-3xl pointer-events-none" />
  <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-gradient-to-tr from-amber-100/20 to-transparent rounded-full blur-3xl pointer-events-none" />

  <div class="container-wide relative">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-brand-50 border border-brand-200 rounded-full text-sm font-medium text-brand-700 mb-6">
          <span class="w-2 h-2 rounded-full bg-brand-500 animate-pulse" />
          Ingeniero Electrónico · Diseñador PCB
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-surface-900 leading-[1.1] mb-6">
          Diseño y Fabricación
          <span class="text-brand-600">Profesional</span>
          <br />de Circuitos Impresos
        </h1>

        <p class="text-lg sm:text-xl text-surface-600 leading-relaxed max-w-2xl mb-8">
          Más de 20 proyectos documentados. Desde PCBs artesanales hasta
          fabricación profesional. Cada placa cuenta una historia de ingeniería,
          precisión y dedicación.
        </p>

        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href={`${baseUrl}#proyectos`}
            class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-surface-900 text-white font-medium rounded-xl hover:bg-surface-800 transition-all duration-200 active:scale-[0.98]"
          >
            Ver Proyectos
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M19 9l-7 7-7-7" />
            </svg>
          </a>
          <a
            href={`${baseUrl}contacto`}
            class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-surface-100 text-surface-700 font-medium rounded-xl hover:bg-surface-200 transition-all duration-200 active:scale-[0.98]"
          >
            Solicitar Presupuesto
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
            </svg>
          </a>
        </div>

        <div class="flex items-center gap-8 mt-10 pt-10 border-t border-surface-200">
          <div class="flex -space-x-2">
            <div class="w-9 h-9 rounded-full bg-gradient-to-br from-brand-400 to-brand-600 border-2 border-white flex items-center justify-center text-xs font-bold text-white shadow-sm">
              K
            </div>
            <div class="w-9 h-9 rounded-full bg-gradient-to-br from-emerald-400 to-emerald-600 border-2 border-white flex items-center justify-center text-xs font-bold text-white shadow-sm">
              A
            </div>
            <div class="w-9 h-9 rounded-full bg-gradient-to-br from-sky-400 to-sky-600 border-2 border-white flex items-center justify-center text-xs font-bold text-white shadow-sm">
              E
            </div>
            <div class="w-9 h-9 rounded-full bg-gradient-to-br from-amber-400 to-amber-600 border-2 border-white flex items-center justify-center text-xs font-bold text-white shadow-sm">
              N
            </div>
          </div>
          <div>
            <p class="text-sm font-semibold text-surface-900">+20 Proyectos Completados</p>
            <p class="text-sm text-surface-500">Artesanales y profesionales</p>
          </div>
        </div>
      </div>

      <div class="relative hidden lg:block">
        <div class="absolute -inset-4 bg-gradient-to-tr from-brand-200/40 via-transparent to-amber-100/40 rounded-3xl blur-2xl pointer-events-none" />
        <a
          href={`${baseUrl}proyectos/${featuredSlug}/`}
          class="group relative block rounded-3xl overflow-hidden bg-surface-100 border border-surface-200 shadow-xl hover:shadow-2xl transition-all duration-500"
        >
          <img
            src={featuredImage}
            alt={featuredTitle}
            class="w-full aspect-[4/3] object-cover transition-all duration-700 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent" />
          <div class="absolute bottom-0 inset-x-0 p-6">
            <p class="text-xs font-medium text-white/70 uppercase tracking-wider mb-1">Proyecto reciente</p>
            <div class="flex items-center justify-between gap-3">
              <h3 class="text-xl font-bold text-white">{featuredTitle}</h3>
              <span class="inline-flex items-center gap-1.5 text-sm font-medium text-white bg-white/20 backdrop-blur-sm rounded-full px-3.5 py-1.5 group-hover:bg-white/30 transition-colors">
                Ver
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </span>
            </div>
          </div>
        </a>

        <div class="absolute -top-4 -left-4 bg-white rounded-2xl border border-surface-200 shadow-lg px-4 py-3 hidden sm:block">
          <p class="text-2xl font-bold text-brand-600 leading-none mb-1">{featuredSoftware}</p>
          <p class="text-xs text-surface-500">Software de diseño</p>
        </div>
        <div class="absolute -bottom-4 -right-4 bg-white rounded-2xl border border-surface-200 shadow-lg px-4 py-3 hidden sm:block">
          <p class="text-2xl font-bold text-surface-900 leading-none mb-1">{featuredLayers}</p>
          <p class="text-xs text-surface-500">Capas de PCB</p>
        </div>
      </div>
    </div>
  </div>
</section>
