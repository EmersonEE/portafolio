---
import type { CollectionEntry } from 'astro:content';

export interface Props {
  project: CollectionEntry<'proyectos'>;
  index?: number;
}

const { project, index = 0 } = Astro.props;
const { data } = project;

const categoryStyles: Record<string, string> = {
  artesanal: 'badge-artesanal',
  profesional: 'badge-profesional',
  personal: 'badge-personal',
  cliente: 'badge-cliente',
  universitario: 'badge-universitario',
  prototipo: 'badge-prototipo',
};

const categoryLabels: Record<string, string> = {
  artesanal: 'Artesanal',
  profesional: 'Profesional',
  personal: 'Personal',
  cliente: 'Cliente',
  universitario: 'Universitario',
  prototipo: 'Prototipo',
};
---

<a
  href={`/proyectos/${project.slug}/`}
  class="group block rounded-2xl overflow-hidden bg-white border border-surface-200 hover:border-brand-200 shadow-sm hover:shadow-lg transition-all duration-500"
  style={`animation: slideUp 0.6s ease-out ${index * 0.08}s forwards; opacity: 0;`}
>
  <div class="relative aspect-[4/3] overflow-hidden bg-surface-100">
    <img
      src={data.featuredImage}
      alt={data.title}
      class="w-full h-full object-cover transition-all duration-700 group-hover:scale-105"
      loading={index < 6 ? 'eager' : 'lazy'}
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500" />

    <div class="absolute top-3 left-3">
      <span class={categoryStyles[data.category]}>
        {categoryLabels[data.category]}
      </span>
    </div>
  </div>

  <div class="p-5">
    <div class="flex items-center justify-between mb-2">
      <time class="text-xs text-surface-400 font-medium">
        {new Date(data.date).toLocaleDateString('es-ES', { year: 'numeric', month: 'short' })}
      </time>
      <span class="text-xs text-surface-400">{data.specifications.layers} capas</span>
    </div>

    <h3 class="font-semibold text-surface-900 text-lg mb-1.5 group-hover:text-brand-600 transition-colors">
      {data.title}
    </h3>

    <p class="text-sm text-surface-500 leading-relaxed line-clamp-2 mb-3">
      {data.description}
    </p>

    {data.tags && data.tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5">
        {data.tags.slice(0, 3).map((tag) => (
          <span class="text-xs px-2 py-0.5 bg-surface-100 text-surface-600 rounded-md font-medium">
            {tag}
          </span>
        ))}
        {data.tags.length > 3 && (
          <span class="text-xs px-2 py-0.5 text-surface-400">
            +{data.tags.length - 3}
          </span>
        )}
      </div>
    )}
  </div>
</a>
