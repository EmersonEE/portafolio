---
export interface Props {
  projects?: number;
  photos?: number;
  categories?: number;
}

const { projects = 0, photos = 0, categories = 0 } = Astro.props;
const stats = [
  { value: projects, prefix: '+', label: 'Proyectos Documentados' },
  { value: photos, prefix: '+', label: 'Fotografías Documentadas' },
  { value: categories, prefix: '', label: 'Categorías Diferentes' },
  { value: 100, prefix: '', suffix: '%', label: 'Dedicación Artesanal' },
];
---

<section class="container-wide py-16 sm:py-20">
  <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
    {stats.map((stat) => (
      <div class="text-center p-6 rounded-2xl bg-surface-50 border border-surface-200">
        <p class="text-3xl sm:text-4xl font-bold text-brand-600 mb-1">
          <span class="counter" data-target={stat.value} data-prefix={stat.prefix} data-suffix={stat.suffix || ''}>
            {stat.prefix}{stat.value}{stat.suffix || ''}
          </span>
        </p>
        <p class="text-sm text-surface-600">{stat.label}</p>
      </div>
    ))}
  </div>
</section>

<script>
  const counters = document.querySelectorAll<HTMLElement>('.counter');

  const formatNumber = (n: number) => n.toLocaleString('es-ES');

  const animateCounter = (el: HTMLElement) => {
    const target = parseInt(el.dataset.target || '0', 10);
    const prefix = el.dataset.prefix || '';
    const suffix = el.dataset.suffix || '';
    const duration = 1500;
    const start = performance.now();
    let frameId: number;

    const step = (now: number) => {
      const progress = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      const current = Math.round(target * eased);
      el.textContent = `${prefix}${formatNumber(current)}${suffix}`;
      if (progress < 1) {
        frameId = requestAnimationFrame(step);
      }
    };

    frameId = requestAnimationFrame(step);
    return () => cancelAnimationFrame(frameId);
  };

  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    counters.forEach((c) => {
       c.textContent = `${c.dataset.prefix || ''}${formatNumber(parseInt(c.dataset.target || '0', 10))}${c.dataset.suffix || ''}`;
    });
  } else if ('IntersectionObserver' in window) {

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animateCounter(entry.target as HTMLElement);
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.4 }
    );
    counters.forEach((c) => observer.observe(c));
  } else {
    counters.forEach((c) => {
       c.textContent = `${c.dataset.prefix || ''}${formatNumber(parseInt(c.dataset.target || '0', 10))}${c.dataset.suffix || ''}`;
    });
  }
</script>
