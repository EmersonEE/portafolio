---

const year = new Date().getFullYear();
const baseUrl = import.meta.env.BASE_URL;
---

<footer class="border-t border-surface-200 bg-surface-50">
  <div class="container-wide py-12 lg:py-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      <div class="sm:col-span-2 lg:col-span-1">
        <a href={`${baseUrl}`} class="flex items-center gap-2.5 mb-4">
          <div class="w-8 h-8 rounded-lg bg-brand-600 flex items-center justify-center">
            <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <span class="font-bold text-lg">Emerson Pérez · PCB</span>
        </a>
        <p class="text-sm text-surface-500 leading-relaxed">
          Diseño y fabricación profesional de circuitos impresos.
          Transformo tus ideas en hardware funcional.
        </p>
      </div>

      <div>
        <h4 class="font-semibold text-sm text-surface-900 mb-4 uppercase tracking-wider">Navegación</h4>
        <ul class="space-y-2">
          <li><a href={`${baseUrl}`} class="text-sm text-surface-500 hover:text-surface-900 transition-colors">Inicio</a></li>
          <li><a href={`${baseUrl}#proyectos`} class="text-sm text-surface-500 hover:text-surface-900 transition-colors">Proyectos</a></li>
          <li><a href={`${baseUrl}servicios`} class="text-sm text-surface-500 hover:text-surface-900 transition-colors">Servicios</a></li>
          <li><a href={`${baseUrl}sobre-mi`} class="text-sm text-surface-500 hover:text-surface-900 transition-colors">Sobre mí</a></li>
          <li><a href={`${baseUrl}contacto`} class="text-sm text-surface-500 hover:text-surface-900 transition-colors">Contacto</a></li>
        </ul>
      </div>

      <div>
        <h4 class="font-semibold text-sm text-surface-900 mb-4 uppercase tracking-wider">Categorías</h4>
        <ul class="space-y-2">
          <li><a href={`${baseUrl}?categoria=artesanal`} class="text-sm text-surface-500 hover:text-surface-900 transition-colors">PCBs Artesanales</a></li>
          <li><a href={`${baseUrl}?categoria=profesional`} class="text-sm text-surface-500 hover:text-surface-900 transition-colors">PCBs Profesionales</a></li>
          <li><a href={`${baseUrl}?categoria=personal`} class="text-sm text-surface-500 hover:text-surface-900 transition-colors">Proyectos Personales</a></li>
          <li><a href={`${baseUrl}?categoria=cliente`} class="text-sm text-surface-500 hover:text-surface-900 transition-colors">Proyectos para Clientes</a></li>
          <li><a href={`${baseUrl}?categoria=universitario`} class="text-sm text-surface-500 hover:text-surface-900 transition-colors">Proyectos Universitarios</a></li>
          <li><a href={`${baseUrl}?categoria=prototipo`} class="text-sm text-surface-500 hover:text-surface-900 transition-colors">Prototipos</a></li>
        </ul>
      </div>

      <div>
        <h4 class="font-semibold text-sm text-surface-900 mb-4 uppercase tracking-wider">Redes</h4>
        <ul class="space-y-2">
          <li>
            <a href="https://github.com/EmersonEE" target="_blank" rel="noopener noreferrer" class="text-sm text-surface-500 hover:text-surface-900 transition-colors">
              GitHub
            </a>
          </li>
          <li>
            <a href="https://www.linkedin.com/in/emerson-aldair-perez-rivera-84412b115/" target="_blank" rel="noopener noreferrer" class="text-sm text-surface-500 hover:text-surface-900 transition-colors">
              LinkedIn
            </a>
          </li>
          <li>
            <a href="https://wa.me/50249964191" target="_blank" rel="noopener noreferrer" class="text-sm text-surface-500 hover:text-surface-900 transition-colors">
              WhatsApp
            </a>
          </li>
          <li>
            <a href="https://www.instagram.com/emersonperez5202/" target="_blank" rel="noopener noreferrer" class="text-sm text-surface-500 hover:text-surface-900 transition-colors">
              Instagram
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="border-t border-surface-200 mt-10 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-sm text-surface-400">
        &copy; {year} Emerson Pérez. Todos los derechos reservados.
      </p>
      <p class="text-sm text-surface-400">
        Hecho con dedicación por Emerson Pérez
      </p>
    </div>
  </div>
</footer>
