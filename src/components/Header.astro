---
const baseUrl = import.meta.env.BASE_URL;
const navItems = [
  { label: 'Inicio', href: `${baseUrl}` },
  { label: 'Proyectos', href: `${baseUrl}#proyectos` },
  { label: 'Servicios', href: `${baseUrl}servicios` },
  { label: 'Sobre mí', href: `${baseUrl}sobre-mi` },
  { label: 'Contacto', href: `${baseUrl}contacto` },
];
---

<header class="fixed top-0 left-0 right-0 z-50 glass">
  <div class="container-wide">
    <div class="flex items-center justify-between h-16 sm:h-20">
      <a
        href={`${baseUrl}`}
        class="flex items-center gap-2.5 group"
        aria-label="Inicio"
      >
        <div class="w-8 h-8 rounded-lg bg-brand-600 flex items-center justify-center transition-transform duration-300 group-hover:scale-105 shadow-sm shadow-brand-500/20">
          <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </div>
        <span class="font-bold text-lg tracking-tight text-surface-900 dark:text-white"><span class="hidden sm:inline">Emerson Pérez · </span>PCB</span>
      </a>

      <div class="flex items-center gap-2">
        <nav class="hidden md:flex items-center gap-1">
          {navItems.map((item) => (
            <a
              href={item.href}
              class="px-4 py-2 text-sm font-medium text-surface-600 hover:text-surface-900 dark:text-surface-300 dark:hover:text-white rounded-lg hover:bg-surface-100 dark:hover:bg-surface-800/60 transition-all duration-200"
            >
              {item.label}
            </a>
          ))}
        </nav>

        <!-- Theme Toggle Button (Desktop & Mobile) -->
        <button
          id="theme-toggle"
          type="button"
          class="p-2 rounded-xl text-surface-600 dark:text-surface-300 hover:text-surface-900 dark:hover:text-white hover:bg-surface-100 dark:hover:bg-surface-800/60 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
          aria-label="Cambiar tema claro / oscuro"
          title="Cambiar tema"
        >
          <!-- Sun Icon (shown in dark mode) -->
          <svg class="w-5 h-5 hidden dark:block text-amber-400 transition-transform duration-300 hover:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <!-- Moon Icon (shown in light mode) -->
          <svg class="w-5 h-5 block dark:hidden text-surface-700 transition-transform duration-300 hover:-rotate-12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>

        <button
          class="md:hidden p-2 rounded-lg text-surface-700 dark:text-surface-300 hover:bg-surface-100 dark:hover:bg-surface-800 transition-colors"
          id="menu-toggle"
          aria-label="Abrir menú"
          aria-controls="mobile-menu"
          aria-expanded="false"
        >
          <svg aria-hidden="true" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div class="md:hidden hidden border-t border-surface-200 dark:border-surface-800 bg-white/95 dark:bg-surface-950/95 backdrop-blur-xl" id="mobile-menu">
    <div class="container-wide py-4 space-y-1">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="block px-4 py-3 text-sm font-medium text-surface-600 hover:text-surface-900 dark:text-surface-300 dark:hover:text-white rounded-lg hover:bg-surface-100 dark:hover:bg-surface-800/60 transition-all"
        >
          {item.label}
        </a>
      ))}
    </div>
  </div>
</header>

<script>
  // Mobile menu handler
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');

  if (toggle && menu) {
    const setMenuState = (isOpen: boolean) => {
      menu.classList.toggle('hidden', !isOpen);
      toggle.setAttribute('aria-expanded', String(isOpen));
      toggle.setAttribute('aria-label', isOpen ? 'Cerrar menú' : 'Abrir menú');
      if (menuIcon) {
        menuIcon.setAttribute('d', isOpen ? 'M6 6l12 12M6 18L18 6' : 'M4 6h16M4 12h16M4 18h16');
      }
    };

    toggle.addEventListener('click', () => {
      setMenuState(menu.classList.contains('hidden'));
    });
    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenuState(false)));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.classList.contains('hidden')) {
        setMenuState(false);
        toggle.focus();
      }
    });
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 768) setMenuState(false);
    });
  }

  // Header scroll appearance
  const header = document.querySelector('header');
  if (header) {
    const updateHeader = () => header.classList.toggle('is-scrolled', window.scrollY > 12);
    window.addEventListener('scroll', updateHeader, { passive: true });
    updateHeader();
  }

  // Theme toggle handler
  const themeToggle = document.getElementById('theme-toggle');
  if (themeToggle) {
    themeToggle.addEventListener('click', () => {
      const isDark = document.documentElement.classList.contains('dark');
      if (isDark) {
        document.documentElement.classList.remove('dark');
        localStorage.setItem('theme', 'light');
      } else {
        document.documentElement.classList.add('dark');
        localStorage.setItem('theme', 'dark');
      }
    });
  }
</script>
