---
const baseUrl = import.meta.env.BASE_URL;
const navItems = [
  { label: 'Inicio', href: `${baseUrl}` },
  { label: 'Proyectos', href: `${baseUrl}#proyectos` },
  { label: 'Servicios', href: `${baseUrl}servicios` },
  { label: 'Sobre mí', href: `${baseUrl}sobre-mi` },
  { label: 'Contacto', href: `${baseUrl}contacto` },
];
---

<header class="fixed top-0 left-0 right-0 z-50 glass">
  <div class="container-wide">
    <div class="flex items-center justify-between h-16 sm:h-20">
      <a
        href={`${baseUrl}`}
        class="flex items-center gap-2.5 group"
        aria-label="Inicio"
      >
        <div class="w-8 h-8 rounded-lg bg-brand-600 flex items-center justify-center transition-transform duration-300 group-hover:scale-105">
          <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </div>
        <span class="font-bold text-lg tracking-tight">Emerson Pérez · PCB</span>
      </a>

      <nav class="hidden md:flex items-center gap-1">
        {navItems.map((item) => (
          <a
            href={item.href}
            class="px-4 py-2 text-sm font-medium text-surface-600 hover:text-surface-900 rounded-lg hover:bg-surface-100 transition-all duration-200"
          >
            {item.label}
          </a>
        ))}
      </nav>

      <button
        class="md:hidden p-2 rounded-lg hover:bg-surface-100 transition-colors"
        id="menu-toggle"
        aria-label="Abrir menú"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <svg aria-hidden="true" class="w-6 h-6 text-surface-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <div class="md:hidden hidden border-t border-surface-200 bg-white" id="mobile-menu">
    <div class="container-wide py-4 space-y-1">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="block px-4 py-3 text-sm font-medium text-surface-600 hover:text-surface-900 rounded-lg hover:bg-surface-100 transition-all"
        >
          {item.label}
        </a>
      ))}
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');

  if (toggle && menu) {
    const setMenuState = (isOpen: boolean) => {
      menu.classList.toggle('hidden', !isOpen);
      toggle.setAttribute('aria-expanded', String(isOpen));
      toggle.setAttribute('aria-label', isOpen ? 'Cerrar menú' : 'Abrir menú');
      if (menuIcon) {
        menuIcon.setAttribute('d', isOpen ? 'M6 6l12 12M6 18L18 6' : 'M4 6h16M4 12h16M4 18h16');
      }
    };

    toggle.addEventListener('click', () => {
      setMenuState(menu.classList.contains('hidden'));
    });
    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenuState(false)));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.classList.contains('hidden')) {
        setMenuState(false);
        toggle.focus();
      }
    });
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 768) setMenuState(false);
    });
  }
</script>
