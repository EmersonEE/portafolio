---

---

<form class="space-y-6" id="contact-form" action="https://formsubmit.co/perezemerson85@gmail.com" method="POST">
  <input type="hidden" name="_subject" value="Nuevo mensaje desde el portafolio" />
  <input type="hidden" name="_template" value="table" />
  <input type="hidden" name="_captcha" value="false" />
  <input type="hidden" name="_honey" value="" tabindex="-1" autocomplete="off" />
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    <div>
      <label for="name" class="block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1.5">
        Nombre completo
      </label>
      <input
        type="text"
        id="name"
        name="name"
        required
        autocomplete="name"
        class="w-full px-4 py-3 bg-white dark:bg-surface-900 border border-surface-200 dark:border-surface-700 rounded-xl text-surface-900 dark:text-white placeholder-surface-400 dark:placeholder-surface-500 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-400 dark:focus:border-brand-500 transition-all duration-200"
        placeholder="Tu nombre"
      />
    </div>
    <div>
      <label for="email" class="block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1.5">
        Correo electrónico
      </label>
      <input
        type="email"
        id="email"
        name="email"
        required
        autocomplete="email"
        class="w-full px-4 py-3 bg-white dark:bg-surface-900 border border-surface-200 dark:border-surface-700 rounded-xl text-surface-900 dark:text-white placeholder-surface-400 dark:placeholder-surface-500 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-400 dark:focus:border-brand-500 transition-all duration-200"
        placeholder="perezemerson85@gmail.com"
      />
    </div>
  </div>

  <div>
    <label for="service" class="block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1.5">
      Servicio de interés
    </label>
    <select
      id="service"
      name="service"
      class="w-full px-4 py-3 bg-white dark:bg-surface-900 border border-surface-200 dark:border-surface-700 rounded-xl text-surface-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-400 dark:focus:border-brand-500 transition-all duration-200"
    >
      <option value="">Selecciona un servicio</option>
      <option value="diseno-electronico">Diseño Electrónico</option>
      <option value="diseno-pcb">Diseño PCB</option>
      <option value="fabricacion-artesanal">Fabricación Artesanal</option>
      <option value="ensamblado">Ensamblado</option>
      <option value="soldadura-smd">Soldadura SMD</option>
      <option value="firmware">Desarrollo de Firmware</option>
      <option value="prototipado">Prototipado Rápido</option>
      <option value="consultoria">Consultoría</option>
    </select>
  </div>

  <div>
    <label for="message" class="block text-sm font-medium text-surface-700 dark:text-surface-300 mb-1.5">
      Mensaje
    </label>
    <textarea
      id="message"
      name="message"
      rows="5"
      required
      class="w-full px-4 py-3 bg-white dark:bg-surface-900 border border-surface-200 dark:border-surface-700 rounded-xl text-surface-900 dark:text-white placeholder-surface-400 dark:placeholder-surface-500 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-400 dark:focus:border-brand-500 transition-all duration-200 resize-y min-h-[120px]"
      placeholder="Cuéntame sobre tu proyecto..."
    ></textarea>
  </div>

  <button
    type="submit"
    class="w-full sm:w-auto px-8 py-3.5 bg-surface-900 dark:bg-brand-500 text-white dark:text-surface-950 font-medium rounded-xl hover:bg-surface-800 dark:hover:bg-brand-400 transition-all duration-200 active:scale-[0.98] disabled:opacity-50 disabled:cursor-not-allowed shadow-md shadow-surface-950/10 dark:shadow-brand-500/20"
    id="submit-btn"
  >
    Enviar Mensaje
  </button>

  <div id="form-message" class="hidden" role="status" aria-live="polite" tabindex="-1"></div>
</form>

<script>
  document.addEventListener('astro:page-load', () => {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
    const formMessage = document.getElementById('form-message') as HTMLElement | null;

    if (form && submitBtn && formMessage) {
      const service = new URLSearchParams(window.location.search).get('servicio');
      const serviceSelect = document.getElementById('service') as HTMLSelectElement | null;
      if (service && serviceSelect && Array.from(serviceSelect.options).some((option) => option.value === service)) {
        serviceSelect.value = service;
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if ((form.querySelector('[name="_honey"]') as HTMLInputElement | null)?.value) return;
        submitBtn.disabled = true;
        submitBtn.textContent = 'Enviando...';
        formMessage.className = 'p-4 bg-surface-50 dark:bg-surface-900 border border-surface-200 dark:border-surface-800 text-surface-600 dark:text-surface-300 rounded-xl text-sm';
        formMessage.textContent = 'Enviando tu mensaje...';
        formMessage.classList.remove('hidden');

        const formData = new FormData(form);
        const controller = new AbortController();
        const timeout = window.setTimeout(() => controller.abort(), 15000);

        try {
          const response = await fetch(`https://formsubmit.co/ajax/${form.action.split('/').pop()}`, {
            method: 'POST',
            headers: {
              'Accept': 'application/json',
            },
            body: formData,
            signal: controller.signal,
          });

          if (response.ok) {
            formMessage.className = 'p-4 bg-emerald-50 dark:bg-emerald-950/50 border border-emerald-200 dark:border-emerald-800/60 text-emerald-700 dark:text-emerald-300 rounded-xl text-sm';
            formMessage.textContent = 'Mensaje enviado con éxito. Te responderé a la brevedad.';
            form.reset();
          } else {
            throw new Error('Error al enviar');
          }
        } catch {
          formMessage.className = 'p-4 bg-red-50 dark:bg-red-950/50 border border-red-200 dark:border-red-800/60 text-red-700 dark:text-red-300 rounded-xl text-sm';
          formMessage.textContent = 'Hubo un error al enviar el mensaje. Intenta de nuevo o escríbeme directamente a ';
          const emailLink = document.createElement('a');
          emailLink.href = 'mailto:perezemerson85@gmail.com';
          emailLink.className = 'underline';
          emailLink.textContent = 'perezemerson85@gmail.com';
          formMessage.append(emailLink, '.');
        } finally {
          window.clearTimeout(timeout);
          submitBtn.disabled = false;
          submitBtn.textContent = 'Enviar Mensaje';
          formMessage.focus();
        }
      });
    }
  });
</script>
