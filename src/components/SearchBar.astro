---
export interface Props {
  tags: string[];
  categories: string[];
  currentCategory?: string;
  currentTag?: string;
}

const { tags, categories } = Astro.props;
const sortedTags = [...tags].sort((a, b) => a.localeCompare(b, 'es'));

const categoryLabels: Record<string, string> = {
  artesanal: 'Artesanal',
  profesional: 'Profesional',
  personal: 'Personal',
  cliente: 'Cliente',
  universitario: 'Universitario',
  prototipo: 'Prototipo',
};
---

<div class="space-y-4" id="project-filters">
  <div class="relative">
    <label for="search-input" class="sr-only">Buscar proyectos</label>
    <svg aria-hidden="true" class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-surface-400 dark:text-surface-500 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width={1.5} d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>
    <input
      type="text"
      id="search-input"
      placeholder="Buscar por nombre, tecnología, microcontrolador..."
      class="w-full pl-12 pr-4 py-3.5 bg-surface-50 dark:bg-surface-900 border border-surface-200 dark:border-surface-700 rounded-xl text-surface-900 dark:text-white placeholder-surface-400 dark:placeholder-surface-500 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-400 dark:focus:border-brand-500 transition-all duration-200"
      autocomplete="off"
      enterkeyhint="search"
    />
  </div>

  <div class="flex flex-wrap gap-2" id="filter-chips">
    <button
      class="filter-chip active px-3.5 py-2 text-sm font-medium rounded-xl border transition-all duration-200"
      data-filter="all"
      aria-pressed="true"
    >
      Todos
    </button>
    {categories.map((cat) => (
      <button
        class="filter-chip px-3.5 py-2 text-sm font-medium rounded-xl border transition-all duration-200"
        data-filter={cat}
        aria-pressed="false"
      >
        {categoryLabels[cat] || cat}
      </button>
    ))}
  </div>

  <div class="flex flex-wrap gap-1.5">
    {sortedTags.map((tag) => (
      <button
        class="tag-chip px-2.5 py-1 text-xs font-medium rounded-lg border transition-all duration-200"
        data-tag={tag}
        aria-pressed="false"
      >
        #{tag}
      </button>
    ))}
  </div>
  <p id="project-results" class="text-sm text-surface-500 dark:text-surface-400" role="status" aria-live="polite"></p>
</div>

<script>
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  const filterChips = document.querySelectorAll<HTMLButtonElement>('.filter-chip');
  const tagChips = document.querySelectorAll<HTMLButtonElement>('.tag-chip');
  const projectCards = document.querySelectorAll<HTMLElement>('#project-list > div');
  const resultMessage = document.getElementById('project-results');

  let activeFilter = 'all';
  let activeTag = '';
  let searchQuery = '';

  const urlParams = new URLSearchParams(window.location.search);
  const urlCategory = urlParams.get('categoria');
  const urlTag = urlParams.get('tag');

  if (urlCategory && Array.from(filterChips).some((chip) => chip.dataset.filter === urlCategory)) {
    activeFilter = urlCategory;
    filterChips.forEach((chip) => {
      chip.classList.toggle('active', chip.dataset.filter === urlCategory);
    });
  }

  if (urlTag && Array.from(tagChips).some((chip) => chip.dataset.tag === urlTag)) {
    activeTag = urlTag;
    tagChips.forEach((chip) => {
      chip.classList.toggle('active', chip.dataset.tag === urlTag);
    });
  }

  function filterProjects() {
    projectCards.forEach((card) => {
      const cat = card.dataset.category || '';
      const tags = (card.dataset.tags || '').toLowerCase();
      const technologies = (card.dataset.technologies || '').toLowerCase();
      const software = (card.dataset.software || '').toLowerCase();
      const microcontroller = (card.dataset.microcontroller || '').toLowerCase();
      const client = (card.dataset.client || '').toLowerCase();
      const name = (card.dataset.name || '').toLowerCase();
      const desc = (card.dataset.description || '').toLowerCase();
      const query = searchQuery.toLowerCase();

      const matchesCategory = activeFilter === 'all' || cat === activeFilter;
      const matchesTag = !activeTag || tags.includes(activeTag.toLowerCase());
      const matchesSearch =
        !query ||
        name.includes(query) ||
        desc.includes(query) ||
        tags.includes(query) ||
        technologies.includes(query) ||
        software.includes(query) ||
        microcontroller.includes(query) ||
        client.includes(query);

      if (matchesCategory && matchesTag && matchesSearch) {
        card.style.display = '';
        card.style.animation = 'none';
        card.offsetHeight;
        card.style.animation = 'scaleIn 0.3s ease-out forwards';
      } else {
        card.style.display = 'none';
      }
    });
    if (resultMessage) {
      const visibleCount = Array.from(projectCards).filter((card) => card.style.display !== 'none').length;
      resultMessage.textContent = `${visibleCount} ${visibleCount === 1 ? 'proyecto encontrado' : 'proyectos encontrados'}`;
    }
  }

  if (filterChips.length) {
    filterChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        filterChips.forEach((c) => {
          c.classList.remove('active');
        });
        chip.classList.add('active');
        activeFilter = chip.dataset.filter || 'all';
        filterChips.forEach((c) => c.setAttribute('aria-pressed', c === chip ? 'true' : 'false'));
        tagChips.forEach((c) => {
          c.classList.remove('active');
          c.setAttribute('aria-pressed', 'false');
        });
        activeTag = '';
        updateUrl();
        filterProjects();
      });
    });
  }

  if (tagChips.length) {
    tagChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        tagChips.forEach((c) => {
          c.classList.remove('active');
          c.setAttribute('aria-pressed', 'false');
        });
        filterChips.forEach((c) => {
          c.classList.remove('active');
          c.setAttribute('aria-pressed', 'false');
        });
        chip.classList.add('active');
        chip.setAttribute('aria-pressed', 'true');
        activeTag = chip.dataset.tag || '';
        activeFilter = 'all';
        updateUrl();
        filterProjects();
      });
    });
  }

  if (searchInput) {
    searchInput.addEventListener('input', () => {
      searchQuery = searchInput.value;
      filterProjects();
    });
  }

  function updateUrl() {
    const params = new URLSearchParams(window.location.search);
    if (activeFilter === 'all') params.delete('categoria');
    else params.set('categoria', activeFilter);
    if (activeTag) params.set('tag', activeTag);
    else params.delete('tag');
    const query = params.toString();
    window.history.replaceState({}, '', `${window.location.pathname}${query ? `?${query}` : ''}`);
  }

  // Set initial active state and count
  const activeChip = Array.from(filterChips).find((c) => c.dataset.filter === activeFilter);
  if (activeChip) {
    filterChips.forEach((c) => c.classList.remove('active'));
    activeChip.classList.add('active');
  }
  const activeTagChip = Array.from(tagChips).find((chip) => chip.dataset.tag === activeTag);
  if (activeTagChip) {
    activeTagChip.classList.add('active');
    activeTagChip.setAttribute('aria-pressed', 'true');
  }
  filterProjects();
</script>

<style is:global>
  .filter-chip {
    @apply border-surface-200 dark:border-surface-800 text-surface-600 dark:text-surface-300 hover:border-brand-300 dark:hover:border-brand-600 hover:text-brand-700 dark:hover:text-brand-300 hover:bg-brand-50 dark:hover:bg-brand-950/40 cursor-pointer;
  }

  .filter-chip.active {
    @apply bg-brand-50 dark:bg-brand-950/60 border-brand-300 dark:border-brand-700 text-brand-700 dark:text-brand-300;
  }

  .tag-chip {
    @apply border-surface-200 dark:border-surface-800 text-surface-500 dark:text-surface-400 hover:border-brand-300 dark:hover:border-brand-600 hover:text-brand-600 dark:hover:text-brand-300 hover:bg-brand-50 dark:hover:bg-brand-950/40 cursor-pointer;
  }

  .tag-chip.active {
    @apply bg-brand-50 dark:bg-brand-950/60 border-brand-300 dark:border-brand-700 text-brand-600 dark:text-brand-300;
  }
</style>
