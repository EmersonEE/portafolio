---
export interface Props {
  tags: string[];
  categories: string[];
  currentCategory?: string;
  currentTag?: string;
}

const { tags, categories } = Astro.props;

const categoryLabels: Record<string, string> = {
  artesanal: 'Artesanal',
  profesional: 'Profesional',
  personal: 'Personal',
  cliente: 'Cliente',
  universitario: 'Universitario',
  prototipo: 'Prototipo',
};
---

<div class="space-y-4" id="project-filters">
  <div class="relative">
    <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-surface-400 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width={1.5} d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>
    <input
      type="text"
      id="search-input"
      placeholder="Buscar por nombre, tecnología, microcontrolador..."
      class="w-full pl-12 pr-4 py-3.5 bg-surface-50 border border-surface-200 rounded-xl text-surface-900 placeholder-surface-400 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-400 transition-all duration-200"
      autocomplete="off"
    />
  </div>

  <div class="flex flex-wrap gap-2" id="filter-chips">
    <button
      class="filter-chip active px-3.5 py-2 text-sm font-medium rounded-xl border transition-all duration-200"
      data-filter="all"
    >
      Todos
    </button>
    {categories.map((cat) => (
      <button
        class="filter-chip px-3.5 py-2 text-sm font-medium rounded-xl border transition-all duration-200"
        data-filter={cat}
      >
        {categoryLabels[cat] || cat}
      </button>
    ))}
  </div>

  <div class="flex flex-wrap gap-1.5">
    {tags.sort().map((tag) => (
      <button
        class="tag-chip px-2.5 py-1 text-xs font-medium rounded-lg border transition-all duration-200"
        data-tag={tag}
      >
        #{tag}
      </button>
    ))}
  </div>
</div>

<script>
  const searchInput = document.getElementById('search-input');
  const filterChips = document.querySelectorAll('.filter-chip');
  const tagChips = document.querySelectorAll('.tag-chip');
  const projectCards = document.querySelectorAll('#project-list > a, #project-list > div');

  let activeFilter = 'all';
  let activeTag = '';
  let searchQuery = '';

  const urlParams = new URLSearchParams(window.location.search);
  const urlCategory = urlParams.get('categoria');
  const urlTag = urlParams.get('tag');

  if (urlCategory) {
    activeFilter = urlCategory;
    filterChips.forEach((chip) => {
      chip.classList.toggle('active', chip.dataset.filter === urlCategory);
    });
  }

  if (urlTag) {
    activeTag = urlTag;
    tagChips.forEach((chip) => {
      chip.classList.toggle('active', chip.dataset.tag === urlTag);
    });
  }

  function filterProjects() {
    projectCards.forEach((card) => {
      const cat = card.dataset.category || '';
      const tags = (card.dataset.tags || '').toLowerCase();
      const name = (card.dataset.name || '').toLowerCase();
      const desc = (card.dataset.description || '').toLowerCase();
      const query = searchQuery.toLowerCase();

      const matchesCategory = activeFilter === 'all' || cat === activeFilter;
      const matchesTag = !activeTag || tags.includes(activeTag.toLowerCase());
      const matchesSearch =
        !query ||
        name.includes(query) ||
        desc.includes(query) ||
        tags.includes(query);

      if (matchesCategory && matchesTag && matchesSearch) {
        card.style.display = '';
        card.style.animation = 'none';
        card.offsetHeight;
        card.style.animation = 'scaleIn 0.3s ease-out forwards';
      } else {
        card.style.display = 'none';
      }
    });
  }

  if (filterChips.length) {
    filterChips.forEach((chip) => {
      chip.classList.add(
        'border-surface-200',
        'text-surface-600',
        'hover:border-brand-300',
        'hover:text-brand-700',
        'hover:bg-brand-50',
        'cursor-pointer'
      );
      chip.classList.add('active');
      chip.addEventListener('click', () => {
        filterChips.forEach((c) => {
          c.classList.remove('active', 'bg-brand-50', 'border-brand-300', 'text-brand-700');
          c.classList.add('border-surface-200', 'text-surface-600');
        });
        chip.classList.remove('border-surface-200', 'text-surface-600');
        chip.classList.add('bg-brand-50', 'border-brand-300', 'text-brand-700');
        activeFilter = chip.dataset.filter;
        tagChips.forEach((c) => {
          c.classList.remove('active', 'bg-brand-50', 'border-brand-300', 'text-brand-700');
          c.classList.add('border-surface-200', 'text-surface-600');
        });
        activeTag = '';
        filterProjects();
      });
    });
  }

  if (tagChips.length) {
    tagChips.forEach((chip) => {
      chip.classList.add(
        'border-surface-200',
        'text-surface-500',
        'hover:border-brand-300',
        'hover:text-brand-600',
        'hover:bg-brand-50',
        'cursor-pointer'
      );
      chip.addEventListener('click', () => {
        tagChips.forEach((c) => {
          c.classList.remove('active', 'bg-brand-50', 'border-brand-300', 'text-brand-600');
          c.classList.add('border-surface-200', 'text-surface-500');
        });
        filterChips.forEach((c) => {
          c.classList.remove('active', 'bg-brand-50', 'border-brand-300', 'text-brand-700');
          c.classList.add('border-surface-200', 'text-surface-600');
        });
        chip.classList.remove('border-surface-200', 'text-surface-500');
        chip.classList.add('bg-brand-50', 'border-brand-300', 'text-brand-600');
        activeTag = chip.dataset.tag;
        activeFilter = 'all';
        filterProjects();
      });
    });
  }

  if (searchInput) {
    searchInput.addEventListener('input', () => {
      searchQuery = searchInput.value;
      filterProjects();
    });
  }

  // Set initial active state
  const activeChip = Array.from(filterChips).find(
    (c) => c.dataset.filter === activeFilter
  );
  if (activeChip) {
    activeChip.classList.remove('border-surface-200', 'text-surface-600');
    activeChip.classList.add('bg-brand-50', 'border-brand-300', 'text-brand-700');
  }
</script>

<style is:global>
  .filter-chip.active {
    @apply bg-brand-50 border-brand-300 text-brand-700;
  }

  .tag-chip.active {
    @apply bg-brand-50 border-brand-300 text-brand-600;
  }
</style>
