---
import BaseLayout from '../layouts/BaseLayout.astro';

const baseUrl = import.meta.env.BASE_URL;
const serviceSlugs: Record<string, string> = {
  'Diseño Electrónico': 'diseno-electronico',
  'Diseño PCB': 'diseno-pcb',
  'Fabricación Artesanal': 'fabricacion-artesanal',
  'Ensamblado y Soldadura': 'ensamblado',
  'Desarrollo de Firmware': 'firmware',
  'Prototipado Rápido': 'prototipado',
  'Consultoría Técnica': 'consultoria',
  'Soldadura SMD': 'soldadura-smd',
};
const servicios = [
  {
    title: 'Diseño Electrónico',
    description:
      'Diseño de circuitos electrónicos desde el concepto hasta el esquemático final. Selección de componentes, simulación y optimización para costo y rendimiento.',
    icon: 'cpu',
    features: [
      'Diagramas esquemáticos profesionales',
      'Simulación de circuitos',
      'Selección de componentes',
      'Análisis de costos',
    ],
  },
  {
    title: 'Diseño PCB',
    description:
      'Diseño profesional de placas de circuito impreso en KiCad y EasyEDA. Desde 2 capas hasta 6 capas con routing de alta velocidad y integridad de señal.',
    icon: 'board',
    features: [
      'PCB de 2 a 6 capas',
      'Diseño para fabricación (DFM)',
      'Integridad de señal y potencia',
      'Archivos Gerber y documentación',
    ],
  },
  {
    title: 'Fabricación Artesanal',
    description:
      'Fabricación de prototipos y series pequeñas con proceso artesanal controlado. Ideal para pruebas rápidas y proyectos de bajo volumen.',
    icon: 'tools',
    features: [
      'Transferencia térmica o fotolito',
      'Ataque químico con cloruro férrico',
      'Perforado y estañado manual',
      'Entrega rápida (3-5 días)',
    ],
  },
  {
    title: 'Ensamblado y Soldadura',
    description:
      'Ensamblado profesional de componentes through-hole y SMD. Soldadura manual de alta calidad con inspección visual y pruebas de continuidad.',
    icon: 'wrench',
    features: [
      'Soldadura THT y SMD',
      'Componentes pasivos y activos',
      'Conectores y cables',
      'Pruebas de continuidad',
    ],
  },
  {
    title: 'Desarrollo de Firmware',
    description:
      'Programación de microcontroladores STM32, ESP32, ESP8266 y Arduino. Desarrollo de firmware en C/C++ con comunicación IoT integrada.',
    icon: 'code',
    features: [
      'Firmware en C/C++ y MicroPython',
      'Comunicación WiFi, Bluetooth, LoRa',
      'Protocolos MQTT, HTTP, SPI, I2C',
      'Actualizaciones OTA',
    ],
  },
  {
    title: 'Prototipado Rápido',
    description:
      'De la idea al prototipo funcional en el menor tiempo posible. Ideal para validar conceptos antes de pasar a producción.',
    icon: 'zap',
    features: [
      'Prototipos funcionales en 1-2 semanas',
      'Iteraciones rápidas de diseño',
      'Validación de concepto',
      'Documentación técnica',
    ],
  },
  {
    title: 'Consultoría Técnica',
    description:
      'Asesoría en diseño electrónico, selección de tecnologías, optimización de costos de fabricación y revisión de diseños existentes.',
    icon: 'lightbulb',
    features: [
      'Revisión de esquemáticos y PCB',
      'Optimización para fabricación',
      'Selección de proveedores',
      'Recomendaciones técnicas',
    ],
  },
  {
    title: 'Soldadura SMD',
    description:
      'Soldadura de componentes de montaje superficial con precisión manual. Ideal para prototipos y reparaciones que requieren cuidado especial.',
    icon: 'target',
    features: [
      'Componentes 0402 y mayores',
      'QFP, QFN, SOIC, SOT',
      'Trabajo con stencil y pasta',
      'Reballing de BGA (limitado)',
    ],
  },
];

const icons: Record<string, string> = {
  cpu: 'M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2z',
  board: 'M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4',
  tools: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z',
  wrench: 'M11.42 15.17l-7.26 7.26a2.12 2.12 0 01-3-3l7.26-7.26m3.58-3.58l5.84 5.84a2.12 2.12 0 010 3l-2.12 2.12M14.5 13.5L12 11M9.5 6.5L7 4',
  code: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
  zap: 'M13 10V3L4 14h7v7l9-11h-7z',
  lightbulb: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z',
  target: 'M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4',
};
---

<BaseLayout
  title="Servicios"
  description="Servicios profesionales de diseño electrónico, fabricación de PCBs, ensamblado, soldadura SMD, desarrollo de firmware y consultoría técnica."
>
  <section class="container-wide pt-28 sm:pt-36 pb-16 sm:pb-20">
    <div class="max-w-2xl mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-brand-50 dark:bg-brand-950/40 border border-brand-200 dark:border-brand-800 rounded-full text-sm font-medium text-brand-700 dark:text-brand-300 mb-4">
        Servicios
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-surface-900 dark:text-white mb-4">
        ¿Necesitas ayuda con tu proyecto electrónico?
      </h1>
      <p class="text-lg text-surface-600 dark:text-surface-300 leading-relaxed">
        Ofrezco servicios completos de diseño electrónico y fabricación de PCBs,
        desde el concepto inicial hasta el producto terminado. Cada servicio está
        respaldado por más de 20 proyectos realizados.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {servicios.map((servicio) => (
        <div class="group p-6 sm:p-8 rounded-2xl bg-white dark:bg-surface-900 border border-surface-200 dark:border-surface-800 hover:border-brand-200 dark:hover:border-brand-700/60 shadow-sm hover:shadow-md transition-all duration-300">
          <div class="w-10 h-10 rounded-xl bg-brand-50 dark:bg-brand-950/60 flex items-center justify-center mb-4 group-hover:bg-brand-100 dark:group-hover:bg-brand-900/60 transition-colors">
            <svg class="w-5 h-5 text-brand-600 dark:text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d={icons[servicio.icon] || icons.code} />
            </svg>
          </div>

          <h3 class="text-xl font-semibold text-surface-900 dark:text-white mb-2">{servicio.title}</h3>
          <p class="text-surface-600 dark:text-surface-300 text-sm leading-relaxed mb-4">
            {servicio.description}
          </p>

          <ul class="space-y-1.5">
            {servicio.features.map((feature) => (
              <li class="flex items-start gap-2 text-sm text-surface-500 dark:text-surface-400">
                <svg class="w-4 h-4 text-emerald-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2.5} d="M5 13l4 4L19 7" />
                </svg>
                {feature}
              </li>
            ))}
          </ul>
          <a href={`${baseUrl}contacto?servicio=${serviceSlugs[servicio.title]}`} class="inline-flex items-center gap-2 mt-6 text-sm font-medium text-brand-600 hover:text-brand-700 dark:text-brand-400 dark:hover:text-brand-300 transition-colors">
            Solicitar este servicio
            <span aria-hidden="true">→</span>
          </a>
        </div>
      ))}
    </div>

    <div class="mt-16 p-8 sm:p-10 rounded-2xl bg-surface-900 dark:bg-surface-900/90 border border-transparent dark:border-surface-800 text-white text-center shadow-xl">
      <h2 class="text-2xl sm:text-3xl font-bold mb-3">¿No encuentras lo que buscas?</h2>
      <p class="text-surface-300 mb-6 max-w-lg mx-auto">
        Cada proyecto es único. Contáctame y diseñamos una solución a la medida
        de tus necesidades.
      </p>
      <a
        href={`${baseUrl}contacto`}
        class="inline-flex items-center gap-2 px-8 py-3.5 bg-white dark:bg-brand-500 text-surface-900 dark:text-surface-950 font-semibold rounded-xl hover:bg-surface-100 dark:hover:bg-brand-400 transition-all duration-200 shadow-md"
      >
        Hablemos de tu proyecto
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </section>
</BaseLayout>
