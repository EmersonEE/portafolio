---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
---

<BaseLayout
  title="Contacto"
  description="Contáctame para solicitar presupuestos, consultoría o información sobre mis servicios de diseño y fabricación de PCBs."
>
  <section class="container-wide pt-28 sm:pt-36 pb-16 sm:pb-20">
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 lg:gap-16">
      <div class="lg:col-span-2">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-brand-50 dark:bg-brand-950/40 border border-brand-200 dark:border-brand-800 rounded-full text-sm font-medium text-brand-700 dark:text-brand-300 mb-4">
          Contacto
        </div>

        <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-surface-900 dark:text-white mb-4">
          Trabajemos juntos
        </h1>
        <p class="text-lg text-surface-600 dark:text-surface-300 leading-relaxed mb-10">
          ¿Tienes un proyecto en mente? ¿Necesitas un presupuesto o simplemente
          quieres resolver una duda técnica? Estoy aquí para ayudarte.
        </p>

        <div class="space-y-4">
          <a
            href="https://wa.me/50249964191"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-4 p-4 rounded-xl bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-800/50 hover:bg-emerald-100 dark:hover:bg-emerald-950/50 transition-colors group"
          >
            <div class="w-12 h-12 rounded-xl bg-emerald-100 dark:bg-emerald-900/50 flex items-center justify-center group-hover:bg-emerald-200 dark:group-hover:bg-emerald-800/50 transition-colors shrink-0">
              <svg class="w-6 h-6 text-emerald-600 dark:text-emerald-400" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            </div>
            <div>
              <p class="font-semibold text-surface-900 dark:text-white">WhatsApp</p>
              <p class="text-sm text-surface-500 dark:text-surface-400">+502 4996 4191 · Respuesta rápida</p>
            </div>
          </a>

          <a
            href="mailto:perezemerson85@gmail.com"
            class="flex items-center gap-4 p-4 rounded-xl bg-brand-50 dark:bg-brand-950/30 border border-brand-200 dark:border-brand-800/50 hover:bg-brand-100 dark:hover:bg-brand-950/50 transition-colors group"
          >
            <div class="w-12 h-12 rounded-xl bg-brand-100 dark:bg-brand-900/50 flex items-center justify-center group-hover:bg-brand-200 dark:group-hover:bg-brand-800/50 transition-colors shrink-0">
              <svg class="w-6 h-6 text-brand-600 dark:text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width={1.5} d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <p class="font-semibold text-surface-900 dark:text-white">Correo Electrónico</p>
              <p class="text-sm text-surface-500 dark:text-surface-400">perezemerson85@gmail.com</p>
            </div>
          </a>

          <a
            href="https://github.com/EmersonEE"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-4 p-4 rounded-xl bg-surface-50 dark:bg-surface-900/60 border border-surface-200 dark:border-surface-800 hover:bg-surface-100 dark:hover:bg-surface-800 transition-colors group"
          >
            <div class="w-12 h-12 rounded-xl bg-surface-100 dark:bg-surface-800 flex items-center justify-center group-hover:bg-surface-200 dark:group-hover:bg-surface-700 transition-colors shrink-0">
              <svg class="w-6 h-6 text-surface-700 dark:text-surface-300" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
            </div>
            <div>
              <p class="font-semibold text-surface-900 dark:text-white">GitHub</p>
              <p class="text-sm text-surface-500 dark:text-surface-400">/EmersonEE</p>
            </div>
          </a>

          <a
            href="https://www.instagram.com/emersonperez5202/"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-4 p-4 rounded-xl bg-gradient-to-r from-purple-50 via-pink-50 to-orange-50 dark:from-purple-950/30 dark:via-pink-950/30 dark:to-orange-950/30 border border-purple-200 dark:border-purple-800/50 hover:from-purple-100 hover:via-pink-100 hover:to-orange-100 dark:hover:from-purple-950/50 dark:hover:via-pink-950/50 dark:hover:to-orange-950/50 transition-colors group"
          >
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-purple-100 to-pink-100 dark:from-purple-900/40 dark:to-pink-900/40 flex items-center justify-center group-hover:from-purple-200 group-hover:to-pink-200 dark:group-hover:from-purple-800/50 dark:group-hover:to-pink-800/50 transition-colors shrink-0">
              <svg class="w-6 h-6 text-purple-600 dark:text-purple-400" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
            </div>
            <div>
              <p class="font-semibold text-surface-900 dark:text-white">Instagram</p>
              <p class="text-sm text-surface-500 dark:text-surface-400">@emersonperez5202</p>
            </div>
          </a>

          <a
            href="https://www.linkedin.com/in/emerson-aldair-perez-rivera-84412b115/"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-4 p-4 rounded-xl bg-[#F0F7FF] dark:bg-[#0A66C2]/15 border border-[#B0D4FF] dark:border-[#0A66C2]/30 hover:bg-[#E0EFFF] dark:hover:bg-[#0A66C2]/25 transition-colors group"
          >
            <div class="w-12 h-12 rounded-xl bg-[#D0E8FF] dark:bg-[#0A66C2]/30 flex items-center justify-center group-hover:bg-[#B0D4FF] dark:group-hover:bg-[#0A66C2]/40 transition-colors shrink-0">
              <svg class="w-6 h-6 text-[#0A66C2] dark:text-[#388bfd]" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </div>
            <div>
              <p class="font-semibold text-surface-900 dark:text-white">LinkedIn</p>
              <p class="text-sm text-surface-500 dark:text-surface-400">/in/emerson-pérez</p>
            </div>
          </a>

          <a
            href="https://x.com/EmersonPrez15"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-4 p-4 rounded-xl bg-surface-50 dark:bg-surface-900/60 border border-surface-200 dark:border-surface-800 hover:bg-surface-100 dark:hover:bg-surface-800 transition-colors group"
          >
            <div class="w-12 h-12 rounded-xl bg-surface-100 dark:bg-surface-800 flex items-center justify-center group-hover:bg-surface-200 dark:group-hover:bg-surface-700 transition-colors shrink-0">
              <svg class="w-6 h-6 text-surface-700 dark:text-surface-300" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </div>
            <div>
              <p class="font-semibold text-surface-900 dark:text-white">X / Twitter</p>
              <p class="text-sm text-surface-500 dark:text-surface-400">@EmersonPrez15</p>
            </div>
          </a>
        </div>
      </div>

      <div class="lg:col-span-3">
        <div class="p-6 sm:p-8 rounded-2xl bg-white dark:bg-surface-900 border border-surface-200 dark:border-surface-800 shadow-sm">
          <h2 class="text-2xl font-bold text-surface-900 dark:text-white mb-2">Envíame un mensaje</h2>
          <p class="text-surface-500 dark:text-surface-400 mb-8">
            Completa el formulario y te responderé a la brevedad.
          </p>
          <ContactForm />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
