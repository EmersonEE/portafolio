---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import SearchBar from '../components/SearchBar.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('proyectos');
const baseUrl = import.meta.env.BASE_URL;

allProjects.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const allTags = [...new Set(allProjects.flatMap((p) => p.data.tags))].sort();
const allCategories = [
  ...new Set(allProjects.map((p) => p.data.category)),
].sort();
---

<BaseLayout
  title="Emerson Pérez - Diseño y Fabricación de Circuitos Impresos"
  description="Portafolio profesional de diseño y fabricación de PCBs. Más de 20 proyectos documentados con más de 100 fotografías del proceso completo."
>
  <Hero />

  <Stats />

  <section id="proyectos" class="container-wide py-16 sm:py-20">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
      <div>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight mb-2">Proyectos</h2>
        <p class="text-surface-500 text-lg">
          {allProjects.length} proyectos documentados de principio a fin
        </p>
      </div>
      <a
        href={`${baseUrl}contacto`}
        class="inline-flex items-center gap-2 text-sm font-medium text-brand-600 hover:text-brand-700 transition-colors shrink-0"
      >
        ¿Tienes un proyecto en mente?
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>

    <SearchBar tags={allTags} categories={allCategories} />

    <div
      id="project-list"
      class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"
    >
      {allProjects.map((project) => {
        const { data } = project;
        return (
          <div
            data-category={data.category}
            data-tags={data.tags.join(' ')}
            data-name={data.title}
            data-description={data.description}
            style="animation: scaleIn 0.3s ease-out forwards"
          >
            <a
              href={`${baseUrl}proyectos/${project.slug}/`}
              class="group block rounded-2xl overflow-hidden bg-white border border-surface-200 hover:border-brand-200 shadow-sm hover:shadow-lg transition-all duration-500"
            >
              <div class="relative aspect-[4/3] overflow-hidden bg-surface-100">
                <img
                  src={`${baseUrl}${data.featuredImage.replace(/^\//, '')}`}
                  alt={data.title}
                  class="w-full h-full object-cover transition-all duration-700 group-hover:scale-105"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500" />
                <div class="absolute top-3 left-3">
                  <span class={`badge-${data.category}`}>
                    {{
                      artesanal: 'Artesanal',
                      profesional: 'Profesional',
                      personal: 'Personal',
                      cliente: 'Cliente',
                      universitario: 'Universitario',
                      prototipo: 'Prototipo',
                    }[data.category] || data.category}
                  </span>
                </div>
              </div>
              <div class="p-5">
                <div class="flex items-center justify-between mb-2">
                  <time class="text-xs text-surface-400 font-medium">
                    {new Date(data.date).toLocaleDateString('es-ES', {
                      year: 'numeric',
                      month: 'short',
                    })}
                  </time>
                  <span class="text-xs text-surface-400">{data.specifications.layers} capas</span>
                </div>
                <h3 class="font-semibold text-surface-900 text-lg mb-1.5 group-hover:text-brand-600 transition-colors">
                  {data.title}
                </h3>
                <p class="text-sm text-surface-500 leading-relaxed line-clamp-2 mb-3">
                  {data.description}
                </p>
                {data.tags.length > 0 && (
                  <div class="flex flex-wrap gap-1.5">
                    {data.tags.slice(0, 3).map((tag) => (
                      <span class="text-xs px-2 py-0.5 bg-surface-100 text-surface-600 rounded-md font-medium">
                        {tag}
                      </span>
                    ))}
                    {data.tags.length > 3 && (
                      <span class="text-xs px-2 py-0.5 text-surface-400">
                        +{data.tags.length - 3}
                      </span>
                    )}
                  </div>
                )}
              </div>
            </a>
          </div>
        );
      })}
    </div>
  </section>

  <section class="bg-surface-50 border-t border-surface-200">
    <div class="container-wide py-16 sm:py-20 text-center">
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight mb-4">
        ¿Listo para tu proyecto?
      </h2>
      <p class="text-lg text-surface-600 max-w-xl mx-auto mb-8">
        Desde un prototipo rápido hasta producción profesional.
        Trabajemos juntos para hacer realidad tu diseño electrónico.
      </p>
      <a
        href={`${baseUrl}contacto`}
        class="inline-flex items-center gap-2 px-8 py-3.5 bg-surface-900 text-white font-medium rounded-xl hover:bg-surface-800 transition-all duration-200 active:scale-[0.98]"
      >
        Solicitar Presupuesto
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </section>
</BaseLayout>
