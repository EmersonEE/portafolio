---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import FeaturedProject from '../components/FeaturedProject.astro';
import SearchBar from '../components/SearchBar.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const allProjects = await getCollection('proyectos');
const baseUrl = import.meta.env.BASE_URL;

allProjects.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const allTags = [...new Set(allProjects.flatMap((p) => p.data.tags))].sort();
const allCategories = [
  ...new Set(allProjects.map((p) => p.data.category)),
].sort();

const featured =
  allProjects.find((p) => p.slug === 'entrenadora-esp32') || allProjects[0];
const featuredData = featured?.data;
---

<BaseLayout
  title="Emerson Pérez - Diseño y Fabricación de Circuitos Impresos"
  description="Portafolio profesional de diseño y fabricación de PCBs. Más de 20 proyectos documentados con más de 100 fotografías del proceso completo."
  image={featuredData?.featuredImage}
>
  {featuredData && (
    <Hero
      featuredImage={featuredData.featuredImage}
      featuredTitle={featuredData.title || ''}
      featuredSlug={featured?.slug || ''}
      featuredSoftware={featuredData.specifications.software || 'KiCad'}
      featuredLayers={featuredData.specifications.layers || 2}
    />
  )}

  <Stats
    projects={allProjects.length}
    photos={allProjects.reduce((total, project) => total + project.data.images.length, 0)}
    categories={allCategories.length}
  />

  {featured && <FeaturedProject project={featured} />}

  <section id="proyectos" class="container-wide py-16 sm:py-20">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
      <div>
        <p class="eyebrow mb-3">Trabajo seleccionado</p>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-surface-900 dark:text-white mb-2">Proyectos</h2>
        <p class="text-surface-500 dark:text-surface-400 text-lg">
          {allProjects.length} proyectos documentados de principio a fin
        </p>
      </div>
      <a
        href={`${baseUrl}contacto`}
        class="inline-flex items-center gap-2 text-sm font-medium text-brand-600 hover:text-brand-700 dark:text-brand-400 dark:hover:text-brand-300 transition-colors shrink-0"
      >
        ¿Tienes un proyecto en mente?
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>

    <SearchBar tags={allTags} categories={allCategories} />

    <div
      id="project-list"
      class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"
    >
      {allProjects.map((project) => {
        const { data } = project;
        return (
          <div
            data-category={data.category}
            data-tags={data.tags.join(' ')}
            data-name={data.title}
            data-description={data.description}
            data-technologies={data.technologies.join(' ')}
            data-software={data.specifications.software}
            data-microcontroller={data.specifications.microcontroller || ''}
            data-client={data.client || ''}
            style="animation: scaleIn 0.3s ease-out forwards"
          >
            <a
              href={`${baseUrl}proyectos/${project.slug}/`}
              class="group block rounded-2xl overflow-hidden bg-white dark:bg-surface-900 border border-surface-200 dark:border-surface-800 hover:border-brand-300 dark:hover:border-brand-500/50 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-500"
            >
              <div class="relative aspect-[4/3] overflow-hidden bg-surface-100 dark:bg-surface-800">
                <Image
                  src={data.featuredImage}
                  alt={data.title}
                  width={600}
                  height={450}
                  class="w-full h-full object-cover transition-all duration-700 group-hover:scale-105"
                  loading="lazy"
                  decoding="async"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-surface-950/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500" />
                <div class="absolute top-3 left-3">
                  <span class={`badge-${data.category}`}>
                    {{
                      artesanal: 'Artesanal',
                      profesional: 'Profesional',
                      personal: 'Personal',
                      cliente: 'Cliente',
                      universitario: 'Universitario',
                      prototipo: 'Prototipo',
                    }[data.category] || data.category}
                  </span>
                </div>
              </div>
              <div class="p-5">
                <div class="flex items-center justify-between mb-2">
                  <time class="text-xs text-surface-400 dark:text-surface-500 font-medium" datetime={data.date}>
                    {new Date(data.date).toLocaleDateString('es-ES', {
                      year: 'numeric',
                      month: 'short',
                    })}
                  </time>
                  <span class="text-xs text-surface-400 dark:text-surface-500">{data.specifications.layers} capas</span>
                </div>
                <h3 class="font-semibold text-surface-900 dark:text-white text-lg mb-1.5 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">
                  {data.title}
                </h3>
                <p class="text-sm text-surface-500 dark:text-surface-400 leading-relaxed line-clamp-2 mb-3">
                  {data.description}
                </p>
                {data.tags.length > 0 && (
                  <div class="flex flex-wrap gap-1.5">
                    {data.tags.slice(0, 3).map((tag) => (
                      <span class="text-xs px-2 py-0.5 bg-surface-100 dark:bg-surface-800 text-surface-600 dark:text-surface-300 rounded-md font-medium">
                        {tag}
                      </span>
                    ))}
                    {data.tags.length > 3 && (
                      <span class="text-xs px-2 py-0.5 text-surface-400 dark:text-surface-500">
                        +{data.tags.length - 3}
                      </span>
                    )}
                  </div>
                )}
              </div>
            </a>
          </div>
        );
      })}
    </div>
    <div id="no-projects" class="hidden text-center py-16" aria-live="polite">
      <h3 class="text-lg font-semibold text-surface-700 dark:text-surface-200 mb-1">No se encontraron proyectos</h3>
      <p class="text-sm text-surface-500 dark:text-surface-400">Prueba con otra búsqueda, categoría o etiqueta.</p>
    </div>
  </section>

  <section class="relative overflow-hidden bg-surface-950 border-t border-surface-800">
    <div class="absolute inset-0 opacity-20 pointer-events-none" style="background-image: radial-gradient(circle at 20% 20%, #10b981 0, transparent 24%), radial-gradient(circle at 80% 80%, #f59e0b 0, transparent 20%);" />
    <div class="container-wide relative py-16 sm:py-20 text-center">
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight mb-4">
        <span class="text-white">¿Listo para tu proyecto?</span>
      </h2>
      <p class="text-lg text-surface-300 max-w-xl mx-auto mb-8">
        Desde un prototipo rápido hasta producción profesional.
        Trabajemos juntos para hacer realidad tu diseño electrónico.
      </p>
      <a
        href={`${baseUrl}contacto`}
        class="inline-flex items-center gap-2 px-8 py-3.5 bg-brand-400 text-surface-950 font-semibold rounded-xl hover:bg-brand-300 transition-all duration-200 active:scale-[0.98] shadow-lg shadow-brand-500/20"
      >
        Solicitar Presupuesto
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  const projectList = document.getElementById('project-list');
  const noProjects = document.getElementById('no-projects');
  if (projectList && noProjects) {
    const updateEmptyState = () => {
      const hasVisibleProjects = Array.from(projectList.children).some((card) => (card as HTMLElement).style.display !== 'none');
      noProjects.classList.toggle('hidden', hasVisibleProjects);
    };
    const observer = new MutationObserver(updateEmptyState);
    observer.observe(projectList, { attributes: true, subtree: true, attributeFilter: ['style'] });
    updateEmptyState();
  }
</script>
