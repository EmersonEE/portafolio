---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';

export interface Props {
  project: CollectionEntry<'proyectos'>;
}

const { project } = Astro.props;
const { data } = project;
const baseUrl = import.meta.env.BASE_URL;

const categoryLabels: Record<string, string> = {
  artesanal: 'Artesanal',
  profesional: 'Profesional',
  personal: 'Personal',
  cliente: 'Cliente',
  universitario: 'Universitario',
  prototipo: 'Prototipo',
};
---

<BaseLayout
  title={data.title}
  description={data.description}
  image={data.featuredImage}
>
  <article class="container-narrow py-16 lg:py-24">
    <header class="mb-12">
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <span class={`badge-${data.category}`}>
          {categoryLabels[data.category]}
        </span>
        <span class={`badge-${data.status}`}>
          {data.status === 'completado' ? 'Completado' : data.status === 'en-progreso' ? 'En Progreso' : 'Pausado'}
        </span>
        <time class="text-sm text-surface-500" datetime={data.date}>
          {new Date(data.date).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
      </div>

      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight mb-4">
        {data.title}
      </h1>
      <p class="text-xl text-surface-600 leading-relaxed max-w-3xl">
        {data.description}
      </p>
    </header>

    <section class="mb-16">
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 p-6 bg-surface-50 rounded-2xl">
        <div>
          <p class="text-xs font-medium text-surface-500 uppercase tracking-wider mb-1">Capas</p>
          <p class="font-semibold">{data.specifications.layers}</p>
        </div>
        <div>
          <p class="text-xs font-medium text-surface-500 uppercase tracking-wider mb-1">Dimensiones</p>
          <p class="font-semibold">{data.specifications.dimensions}</p>
        </div>
        <div>
          <p class="text-xs font-medium text-surface-500 uppercase tracking-wider mb-1">Tipo</p>
          <p class="font-semibold">{data.specifications.type}</p>
        </div>
        <div>
          <p class="text-xs font-medium text-surface-500 uppercase tracking-wider mb-1">Software</p>
          <p class="font-semibold">{data.specifications.software}</p>
        </div>
        {data.specifications.microcontroller && (
          <div>
            <p class="text-xs font-medium text-surface-500 uppercase tracking-wider mb-1">Microcontrolador</p>
            <p class="font-semibold">{data.specifications.microcontroller}</p>
          </div>
        )}
        {data.client && (
          <div>
            <p class="text-xs font-medium text-surface-500 uppercase tracking-wider mb-1">Cliente</p>
            <p class="font-semibold">{data.client}</p>
          </div>
        )}
      </div>
    </section>

    <div class="prose prose-lg max-w-none mb-16">
      <slot />
    </div>

    {data.objective && (
      <section class="mb-16">
        <h2 class="text-2xl font-bold mb-4">Objetivo</h2>
        <p class="text-surface-700 leading-relaxed">{data.objective}</p>
      </section>
    )}

    {data.images && data.images.length > 0 && (
      <section class="mb-16" id="galeria">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-2">
          <div>
            <h2 class="text-2xl font-bold">Galería del Proceso</h2>
            <p class="text-surface-500 text-sm mt-1">{data.images.length} imágenes documentadas</p>
          </div>
        </div>

        <div class="flex flex-wrap gap-2 mb-6" id="phase-filters">
          <button class="phase-filter px-3.5 py-2 text-sm font-medium rounded-xl border transition-all duration-200" data-phase="all">
            Todas
          </button>
          <button class="phase-filter px-3.5 py-2 text-sm font-medium rounded-xl border transition-all duration-200" data-phase="diseno">
            Diseño
          </button>
          <button class="phase-filter px-3.5 py-2 text-sm font-medium rounded-xl border transition-all duration-200" data-phase="fabricacion">
            Fabricación
          </button>
          <button class="phase-filter px-3.5 py-2 text-sm font-medium rounded-xl border transition-all duration-200" data-phase="final">
            Final
          </button>
          <button class="phase-filter px-3.5 py-2 text-sm font-medium rounded-xl border transition-all duration-200" data-phase="pruebas">
            Pruebas
          </button>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 sm:gap-4" id="gallery">
          {data.images.map((img, i) => (
            <a
              href={`${baseUrl}${img.src.replace(/^\//, '')}`}
              class="group block rounded-xl overflow-hidden bg-surface-100 cursor-pointer gallery-item"
              data-phase={img.phase}
              data-caption={img.alt}
            >
              <img
                src={`${baseUrl}${img.src.replace(/^\//, '')}`}
                alt={img.alt}
                class="w-full block"
                style="display: block; width: 100%; height: auto;"
              />
            </a>
          ))}
        </div>
      </section>
    )}

    <script is:inline src={`${import.meta.env.BASE_URL}scripts/photoswipe.umd.min.js`}></script>
    <script is:inline src={`${import.meta.env.BASE_URL}scripts/photoswipe-lightbox.umd.min.js`}></script>
    <script is:inline>
      (function() {
        const gallery = document.getElementById('gallery');
        if (!gallery) return;

        function initLightbox() {
          const lightbox = new PhotoSwipeLightbox({
            gallery: '#gallery',
            children: 'a',
            showHideAnimationType: 'fade',
            bgOpacity: 0.95,
            wheelToZoom: true,
            closeOnVerticalDrag: true,
            pswpModule: PhotoSwipe,
          });

          lightbox.on('uiRegister', () => {
            lightbox.pswp.ui.registerElement({
              name: 'download-button',
              order: 8,
              isButton: true,
              html: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>',
              onClick: () => {
                const slide = lightbox.pswp.currSlide;
                if (slide) {
                  const link = document.createElement('a');
                  link.download = slide.data.src.split('/').pop();
                  link.href = slide.data.src;
                  link.click();
                }
              },
            });
          });

          lightbox.on('opening', () => {
            document.documentElement.style.overflow = 'hidden';
          });

          lightbox.on('close', () => {
            document.documentElement.style.overflow = '';
          });

          lightbox.init();
        }

        if (typeof PhotoSwipeLightbox !== 'undefined') {
          initLightbox();
        } else {
          document.addEventListener('DOMContentLoaded', initLightbox);
        }
      })();

      (function() {
        const phaseFilters = document.querySelectorAll('.phase-filter');
        const galleryItems = document.querySelectorAll('.gallery-item');

        if (!phaseFilters.length) return;

        phaseFilters.forEach((btn) => {
          btn.classList.add(
            'border-surface-200', 'text-surface-600',
            'hover:border-brand-300', 'hover:text-brand-700', 'hover:bg-brand-50',
            'cursor-pointer'
          );
          btn.addEventListener('click', () => {
            phaseFilters.forEach((b) => {
              b.classList.remove('bg-brand-50', 'border-brand-300', 'text-brand-700');
              b.classList.add('border-surface-200', 'text-surface-600');
            });
            btn.classList.remove('border-surface-200', 'text-surface-600');
            btn.classList.add('bg-brand-50', 'border-brand-300', 'text-brand-700');

            const phase = btn.dataset.phase;
            galleryItems.forEach((item) => {
              if (phase === 'all' || item.dataset.phase === phase) {
                item.style.display = '';
              } else {
                item.style.display = 'none';
              }
            });
          });
        });

        const activeFilter = document.querySelector('.phase-filter[data-phase="all"]');
        if (activeFilter) {
          activeFilter.classList.remove('border-surface-200', 'text-surface-600');
          activeFilter.classList.add('bg-brand-50', 'border-brand-300', 'text-brand-700');
        }
      })();
    </script>

    {data.beforeAfter && (
      <section class="mb-16">
        <h2 class="text-2xl font-bold mb-6">Comparación</h2>
        <div class="relative w-full aspect-[16/10] rounded-2xl overflow-hidden bg-surface-100" id="image-compare">
          <img
            src={`${baseUrl}${data.beforeAfter.before.replace(/^\//, '')}`}
            alt="Antes"
            class="absolute inset-0 w-full h-full object-cover"
          />
          <div class="absolute inset-0 w-1/2 overflow-hidden" id="compare-after">
            <img
              src={`${baseUrl}${data.beforeAfter.after.replace(/^\//, '')}`}
              alt="Después"
              class="absolute inset-0 w-full h-full object-cover"
              style="width: 200%"
            />
          </div>
          <input
            type="range"
            min="0"
            max="100"
            value="50"
            class="absolute inset-0 w-full h-full opacity-0 cursor-ew-resize z-10"
            id="compare-slider"
          />
          <div
            class="absolute top-0 bottom-0 w-0.5 bg-white shadow-lg z-[5]"
            id="compare-line"
            style="left: 50%"
          >
            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-white shadow-lg flex items-center justify-center">
              <svg class="w-4 h-4 text-surface-800" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M8 7l-4 4m0 0l4 4m-4-4h16" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M16 7l4 4m0 0l-4 4m4-4H8" />
              </svg>
            </div>
          </div>
          {data.beforeAfter.label && (
            <>
              <span class="absolute bottom-4 left-4 px-2 py-1 bg-black/60 text-white text-xs rounded z-[5]">Antes</span>
              <span class="absolute bottom-4 right-4 px-2 py-1 bg-black/60 text-white text-xs rounded z-[5]">Después</span>
            </>
          )}
        </div>
        <script>
          const slider = document.getElementById('compare-slider');
          const afterEl = document.getElementById('compare-after');
          const lineEl = document.getElementById('compare-line');

          if (slider && afterEl && lineEl) {
            const update = () => {
              const val = slider.value;
              afterEl.style.width = val + '%';
              lineEl.style.left = val + '%';
            };
            slider.addEventListener('input', update);
            update();
          }
        </script>
      </section>
    )}

    {data.challenges && (
      <section class="mb-8">
        <h2 class="text-2xl font-bold mb-4">Retos</h2>
        <p class="text-surface-700 leading-relaxed">{data.challenges}</p>
      </section>
    )}

    {data.solutions && (
      <section class="mb-16">
        <h2 class="text-2xl font-bold mb-4">Soluciones</h2>
        <p class="text-surface-700 leading-relaxed">{data.solutions}</p>
      </section>
    )}

    {data.timeframe && (
      <div class="flex items-center gap-2 text-surface-600 mb-8">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width={1.5} d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>Tiempo de fabricación: <strong class="text-surface-900">{data.timeframe}</strong></span>
      </div>
    )}

    {data.technologies && data.technologies.length > 0 && (
      <section class="mb-16">
        <h2 class="text-2xl font-bold mb-4">Tecnologías</h2>
        <div class="flex flex-wrap gap-2">
          {data.technologies.map((tech) => (
            <span class="px-3 py-1.5 bg-surface-100 text-surface-700 rounded-full text-sm font-medium">
              {tech}
            </span>
          ))}
        </div>
      </section>
    )}

    {data.tags && data.tags.length > 0 && (
      <section class="mb-16">
        <h2 class="text-2xl font-bold mb-4">Etiquetas</h2>
        <div class="flex flex-wrap gap-2">
          {data.tags.map((tag) => (
            <a
              href={`${baseUrl}?tag=${encodeURIComponent(tag)}`}
              class="px-3 py-1.5 bg-brand-50 text-brand-700 rounded-full text-sm font-medium hover:bg-brand-100 transition-colors"
            >
              #{tag}
            </a>
          ))}
        </div>
      </section>
    )}

    <nav class="border-t border-surface-200 pt-8 mt-16">
      <a
        href={`${baseUrl}`}
        class="inline-flex items-center gap-2 text-surface-600 hover:text-surface-900 transition-colors font-medium"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M7 16l-4-4m0 0l4-4m-4 4h18" />
        </svg>
        Volver a proyectos
      </a>
    </nav>
  </article>
</BaseLayout>
