---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

export interface Props {
  project: CollectionEntry<'proyectos'>;
}

const { project } = Astro.props;
const { data } = project;
const baseUrl = import.meta.env.BASE_URL;

const categoryLabels: Record<string, string> = {
  artesanal: 'Artesanal',
  profesional: 'Profesional',
  personal: 'Personal',
  cliente: 'Cliente',
  universitario: 'Universitario',
  prototipo: 'Prototipo',
};

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(data.featuredImage.src, Astro.site).href;
const projectSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: data.title,
  description: data.description,
  dateCreated: data.date,
  url: pageUrl,
  image: imageUrl,
  creator: {
    '@type': 'Person',
    name: 'Emerson Aldair Pérez Rivera',
  },
});
---

<BaseLayout
  title={data.title}
  description={data.description}
  image={data.featuredImage}
>
  <article class="container-narrow py-16 lg:py-24">
    <header class="mb-12">
      <nav aria-label="Migas de pan" class="mb-6 text-sm text-surface-500 dark:text-surface-400">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href={`${baseUrl}`} class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">Inicio</a></li>
          <li aria-hidden="true">/</li>
          <li><a href={`${baseUrl}#proyectos`} class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">Proyectos</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-surface-700 dark:text-surface-200 font-medium">{data.title}</li>
        </ol>
      </nav>
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <span class={`badge-${data.category}`}>
          {categoryLabels[data.category]}
        </span>
        <span class={`badge-${data.status}`}>
          {data.status === 'completado' ? 'Completado' : data.status === 'en-progreso' ? 'En Progreso' : 'Pausado'}
        </span>
        <time class="text-sm text-surface-500 dark:text-surface-400" datetime={data.date}>
          {new Date(data.date).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
      </div>

      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-surface-900 dark:text-white mb-4">
        {data.title}
      </h1>
      <p class="text-xl text-surface-600 dark:text-surface-300 leading-relaxed max-w-3xl">
        {data.description}
      </p>
    </header>

    <script is:inline type="application/ld+json" set:html={projectSchema} />

    <section class="mb-16">
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 p-6 bg-surface-50 dark:bg-surface-900/60 border border-surface-200/60 dark:border-surface-800 rounded-2xl">
        <div>
          <p class="text-xs font-medium text-surface-500 dark:text-surface-400 uppercase tracking-wider mb-1">Capas</p>
          <p class="font-semibold text-surface-900 dark:text-white">{data.specifications.layers}</p>
        </div>
        <div>
          <p class="text-xs font-medium text-surface-500 dark:text-surface-400 uppercase tracking-wider mb-1">Tipo</p>
          <p class="font-semibold text-surface-900 dark:text-white">{data.specifications.type}</p>
        </div>
        <div>
          <p class="text-xs font-medium text-surface-500 dark:text-surface-400 uppercase tracking-wider mb-1">Software</p>
          <p class="font-semibold text-surface-900 dark:text-white">{data.specifications.software}</p>
        </div>
        {data.specifications.microcontroller && (
          <div>
            <p class="text-xs font-medium text-surface-500 dark:text-surface-400 uppercase tracking-wider mb-1">Microcontrolador</p>
            <p class="font-semibold text-surface-900 dark:text-white">{data.specifications.microcontroller}</p>
          </div>
        )}
        {data.client && (
          <div>
            <p class="text-xs font-medium text-surface-500 dark:text-surface-400 uppercase tracking-wider mb-1">Cliente</p>
            <p class="font-semibold text-surface-900 dark:text-white">{data.client}</p>
          </div>
        )}
      </div>
    </section>

    <div class="prose prose-lg max-w-none mb-16">
      <slot />
    </div>

    {data.objective && (
      <section class="mb-16">
        <h2 class="text-2xl font-bold text-surface-900 dark:text-white mb-4">Objetivo</h2>
        <p class="text-surface-700 dark:text-surface-300 leading-relaxed">{data.objective}</p>
      </section>
    )}

    {data.images && data.images.length > 0 && (
      <section class="mb-16" id="galeria">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-4">
          <div>
            <h2 class="text-2xl font-bold text-surface-900 dark:text-white">Galería del Proceso</h2>
            <p class="text-surface-500 dark:text-surface-400 text-sm mt-1">{data.images.length} imágenes documentadas</p>
          </div>
        </div>

        <div class="flex flex-wrap gap-2 mb-6" id="phase-filters">
          <button aria-pressed="true" class="phase-filter active px-3.5 py-2 text-sm font-medium rounded-xl border transition-all duration-200" data-phase="all">
            Todas
          </button>
          <button aria-pressed="false" class="phase-filter px-3.5 py-2 text-sm font-medium rounded-xl border transition-all duration-200" data-phase="diseno">
            Diseño
          </button>
          <button aria-pressed="false" class="phase-filter px-3.5 py-2 text-sm font-medium rounded-xl border transition-all duration-200" data-phase="fabricacion">
            Fabricación
          </button>
          <button aria-pressed="false" class="phase-filter px-3.5 py-2 text-sm font-medium rounded-xl border transition-all duration-200" data-phase="final">
            Final
          </button>
          <button aria-pressed="false" class="phase-filter px-3.5 py-2 text-sm font-medium rounded-xl border transition-all duration-200" data-phase="pruebas">
            Pruebas
          </button>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 sm:gap-4" id="gallery">
          {data.images.map((img, i) => (
            <a
              href={img.src.src}
              class="group block rounded-xl overflow-hidden bg-surface-100 dark:bg-surface-800 border border-surface-200/80 dark:border-surface-700 cursor-pointer gallery-item"
              data-phase={img.phase}
              data-caption={img.alt}
              data-pswp-width={img.src.width}
              data-pswp-height={img.src.height}
            >
              <Image
                src={img.src}
                alt={img.alt}
                width={600}
                height={450}
                class="w-full h-auto block transition-transform duration-500 group-hover:scale-105"
                loading={i < 3 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </a>
          ))}
        </div>
      </section>
    )}

    <script is:inline src={`${import.meta.env.BASE_URL}scripts/photoswipe.umd.min.js`}></script>
    <script is:inline src={`${import.meta.env.BASE_URL}scripts/photoswipe-lightbox.umd.min.js`}></script>
    <script is:inline>
      (function() {
        const gallery = document.getElementById('gallery');
        if (!gallery) return;

        function initLightbox() {
          const lightbox = new PhotoSwipeLightbox({
            gallery: '#gallery',
            children: 'a',
            showHideAnimationType: 'fade',
            bgOpacity: 0.95,
            wheelToZoom: true,
            closeOnVerticalDrag: true,
            pswpModule: PhotoSwipe,
          });

          lightbox.on('uiRegister', () => {
            lightbox.pswp.ui.registerElement({
              name: 'download-button',
              order: 8,
              isButton: true,
              html: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>',
              onClick: () => {
                const slide = lightbox.pswp.currSlide;
                if (slide) {
                  const link = document.createElement('a');
                  link.download = slide.data.src.split('/').pop();
                  link.href = slide.data.src;
                  link.click();
                }
              },
            });
          });

          lightbox.on('opening', () => {
            document.documentElement.style.overflow = 'hidden';
          });

          lightbox.on('close', () => {
            document.documentElement.style.overflow = '';
          });

          lightbox.init();
        }

        if (typeof PhotoSwipeLightbox !== 'undefined') {
          initLightbox();
        } else {
          document.addEventListener('DOMContentLoaded', initLightbox);
        }
      })();

      (function() {
        const phaseFilters = document.querySelectorAll('.phase-filter');
        const galleryItems = document.querySelectorAll('.gallery-item');

        if (!phaseFilters.length) return;

        phaseFilters.forEach((btn) => {
          btn.addEventListener('click', () => {
            phaseFilters.forEach((b) => {
              b.classList.remove('active');
              b.setAttribute('aria-pressed', 'false');
            });
            btn.classList.add('active');
            btn.setAttribute('aria-pressed', 'true');

            const phase = btn.dataset.phase;
            galleryItems.forEach((item) => {
              if (phase === 'all' || item.dataset.phase === phase) {
                item.style.display = '';
              } else {
                item.style.display = 'none';
              }
            });
          });
        });
      })();
    </script>

    <style is:global>
      .phase-filter {
        @apply border-surface-200 dark:border-surface-800 text-surface-600 dark:text-surface-300 hover:border-brand-300 dark:hover:border-brand-600 hover:text-brand-700 dark:hover:text-brand-300 hover:bg-brand-50 dark:hover:bg-brand-950/40 cursor-pointer;
      }
      .phase-filter.active {
        @apply bg-brand-50 dark:bg-brand-950/60 border-brand-300 dark:border-brand-700 text-brand-700 dark:text-brand-300;
      }
    </style>

    {data.beforeAfter && (
      <section class="mb-16">
        <h2 class="text-2xl font-bold text-surface-900 dark:text-white mb-6">Comparación</h2>
        <div class="relative w-full aspect-[16/10] rounded-2xl overflow-hidden bg-surface-100 dark:bg-surface-800 border border-surface-200 dark:border-surface-700" id="image-compare">
          <img
            src={data.beforeAfter.before.src}
            alt="Antes"
            class="absolute inset-0 w-full h-full object-cover"
          />
          <div class="absolute inset-0 w-1/2 overflow-hidden" id="compare-after">
            <img
              src={data.beforeAfter.after.src}
              alt="Después"
              class="absolute inset-0 w-full h-full object-cover"
              style="width: 200%"
            />
          </div>
          <input
            type="range"
            min="0"
            max="100"
            value="50"
            class="absolute inset-0 w-full h-full opacity-0 cursor-ew-resize z-10"
            id="compare-slider"
            aria-label="Comparar imágenes antes y después"
            aria-valuetext="50% de comparación"
          />
          <div
            class="absolute top-0 bottom-0 w-0.5 bg-white shadow-lg z-[5]"
            id="compare-line"
            style="left: 50%"
          >
            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-white shadow-lg flex items-center justify-center">
              <svg class="w-4 h-4 text-surface-800" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M8 7l-4 4m0 0l4 4m-4-4h16" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M16 7l4 4m0 0l-4 4m4-4H8" />
              </svg>
            </div>
          </div>
          {data.beforeAfter.label && (
            <>
              <span class="absolute bottom-4 left-4 px-2 py-1 bg-black/60 text-white text-xs rounded z-[5]">{data.beforeAfter.label || 'Antes'}</span>
              <span class="absolute bottom-4 right-4 px-2 py-1 bg-black/60 text-white text-xs rounded z-[5]">Después</span>
            </>
          )}
        </div>
        <script>
          const slider = document.getElementById('compare-slider') as HTMLInputElement | null;
          const afterEl = document.getElementById('compare-after');
          const lineEl = document.getElementById('compare-line');

          if (slider && afterEl && lineEl) {
            const update = () => {
              const val = slider.value;
              afterEl.style.width = val + '%';
              lineEl.style.left = val + '%';
              slider.setAttribute('aria-valuetext', `${val}% de comparación`);
            };
            slider.addEventListener('input', update);
            update();
          }
        </script>
      </section>
    )}

    {data.challenges && (
      <section class="mb-8">
        <h2 class="text-2xl font-bold text-surface-900 dark:text-white mb-4">Retos</h2>
        <p class="text-surface-700 dark:text-surface-300 leading-relaxed">{data.challenges}</p>
      </section>
    )}

    {data.solutions && (
      <section class="mb-16">
        <h2 class="text-2xl font-bold text-surface-900 dark:text-white mb-4">Soluciones</h2>
        <p class="text-surface-700 dark:text-surface-300 leading-relaxed">{data.solutions}</p>
      </section>
    )}

    {data.timeframe && (
      <div class="flex items-center gap-2 text-surface-600 dark:text-surface-300 mb-8">
        <svg class="w-5 h-5 text-brand-600 dark:text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width={1.5} d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>Tiempo de fabricación: <strong class="text-surface-900 dark:text-white">{data.timeframe}</strong></span>
      </div>
    )}

    {data.technologies && data.technologies.length > 0 && (
      <section class="mb-16">
        <h2 class="text-2xl font-bold text-surface-900 dark:text-white mb-4">Tecnologías</h2>
        <div class="flex flex-wrap gap-2">
          {data.technologies.map((tech) => (
            <span class="px-3 py-1.5 bg-surface-100 dark:bg-surface-800 text-surface-700 dark:text-surface-300 rounded-full text-sm font-medium">
              {tech}
            </span>
          ))}
        </div>
      </section>
    )}

    {data.tags && data.tags.length > 0 && (
      <section class="mb-16">
        <h2 class="text-2xl font-bold text-surface-900 dark:text-white mb-4">Etiquetas</h2>
        <div class="flex flex-wrap gap-2">
          {data.tags.map((tag) => (
            <a
              href={`${baseUrl}?tag=${encodeURIComponent(tag)}`}
              class="px-3 py-1.5 bg-brand-50 dark:bg-brand-950/40 text-brand-700 dark:text-brand-300 border border-brand-200/60 dark:border-brand-800/60 rounded-full text-sm font-medium hover:bg-brand-100 dark:hover:bg-brand-900/60 transition-colors"
            >
              #{tag}
            </a>
          ))}
        </div>
      </section>
    )}

    <nav class="border-t border-surface-200 dark:border-surface-800 pt-8 mt-16">
      <a
        href={`${baseUrl}`}
        class="inline-flex items-center gap-2 text-surface-600 hover:text-surface-900 dark:text-surface-400 dark:hover:text-white transition-colors font-medium"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M7 16l-4-4m0 0l4-4m-4 4h18" />
        </svg>
        Volver a proyectos
      </a>
    </nav>
  </article>
</BaseLayout>
