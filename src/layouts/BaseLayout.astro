---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

import type { ImageMetadata } from 'astro';

export interface Props {
  title: string;
  description?: string;
  image?: string | ImageMetadata;
}

const { title, description, image } = Astro.props;
const siteTitle = 'Emerson Pérez | Diseño y Fabricación de PCBs';
const baseUrl = import.meta.env.BASE_URL;
const site = new URL(baseUrl, Astro.site);
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const imageSrc = typeof image === 'object' && image !== null && 'src' in image ? image.src : image;
const ogImage = imageSrc
  ? (imageSrc.startsWith('http') ? imageSrc : new URL(imageSrc.startsWith(baseUrl) ? imageSrc : `${baseUrl}${imageSrc.replace(/^\//, '')}`, Astro.site).href)
  : new URL(`${baseUrl}favicon.svg`, Astro.site).href;

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: 'Emerson Pérez | Diseño y Fabricación de PCBs',
      url: site.href,
      description:
        'Portafolio profesional de diseño y fabricación de circuitos impresos.',
      inLanguage: 'es',
    },
    {
      '@type': 'Person',
      name: 'Emerson Aldair Pérez Rivera',
      url: site.href,
      jobTitle: 'Diseñador de PCBs y Electrónica',
      email: 'mailto:perezemerson85@gmail.com',
      sameAs: ['https://www.linkedin.com/in/emerson-aldair-perez-rivera-84412b115/'],
    },
    {
      '@type': 'WebPage',
      name: title || siteTitle,
      url: canonical,
      description: description || 'Portafolio profesional de diseño y fabricación de PCBs.',
      inLanguage: 'es',
    },
  ],
});
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
    <link rel="canonical" href={canonical} />

    <title>{title && !title.includes('Emerson Pérez') ? `${title} | Emerson Pérez` : title || siteTitle}</title>
    <meta name="description" content={description || 'Portafolio profesional de diseño y fabricación de PCBs. Circuitos impresos artesanales y profesionales.'} />

    <meta property="og:title" content={title || 'Emerson Pérez | Diseño y Fabricación de PCBs'} />
    <meta property="og:description" content={description || 'Portafolio profesional de diseño y fabricación de PCBs.'} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_ES" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title || siteTitle} />
    <meta name="twitter:description" content={description || 'Portafolio profesional de diseño y fabricación de PCBs.'} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <script is:inline>
      (function() {
        const storedTheme = typeof localStorage !== 'undefined' ? localStorage.getItem('theme') : null;
        const theme = storedTheme || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        if (theme === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>

    <script is:inline type="application/ld+json" set:html={jsonLd} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link rel="stylesheet" href={`${baseUrl}scripts/photoswipe.css`} />

    <script
      is:inline
      data-goatcounter="https://pcb-portfolio.goatcounter.com/count"
      async
      src="//gc.zgo.at/count.js"
    ></script>
  </head>
  <body class="flex flex-col min-h-screen bg-white text-surface-900 dark:bg-surface-950 dark:text-surface-100">
    <Header />
    <main class="flex-1">
      <slot />
    </main>

    <button
      id="scroll-top"
      class="fixed bottom-6 right-6 z-40 w-10 h-10 rounded-xl bg-surface-900 text-white dark:bg-surface-800 dark:text-surface-100 dark:border dark:border-surface-700 shadow-lg flex items-center justify-center opacity-0 invisible translate-y-4 transition-all duration-300 hover:bg-surface-800 dark:hover:bg-surface-700 active:scale-95"
      aria-label="Volver arriba"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M5 15l7-7 7 7" />
      </svg>
    </button>

    <script>
      const scrollBtn = document.getElementById('scroll-top');
      if (scrollBtn) {
        const toggle = () => {
          if (window.scrollY > 400) {
            scrollBtn.classList.remove('opacity-0', 'invisible', 'translate-y-4');
            scrollBtn.classList.add('opacity-100', 'visible', 'translate-y-0');
          } else {
            scrollBtn.classList.remove('opacity-100', 'visible', 'translate-y-0');
            scrollBtn.classList.add('opacity-0', 'invisible', 'translate-y-4');
          }
        };
        window.addEventListener('scroll', toggle, { passive: true });
        scrollBtn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
        toggle();
      }
    </script>

    <Footer />
  </body>
</html>
